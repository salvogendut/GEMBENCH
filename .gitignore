# Build artifacts
*.bin
*.BIN
*.RAW
bin/
build/
# CPC disk images
*.dsk
*.DSK

# Assembler / build intermediates
*.o
*.lst
*.sym
*.map
rom/gitcommit.inc          # generated by tools/build_rom.sh (git commit -> ROM boot banner)

# Emulator screenshots (1984 F4 dumps)
*.ppm

# Python artifacts
__pycache__/
*.pyc

# Editor / OS cruft
*~
.DS_Store

# The staged distribution QA/ is shipped in the repo (including the ready-to-deploy
# QA/CPC/CARD/ and QA/CPC/Floppies/), so re-include it despite the binary ignores above.
# Regenerate with `bash tools/build_kernel.sh`.
!QA/**
# Fetched third-party TCP/IP UNAPI TSR and its staged license notice.
QA/MSX/CARD/UNAPINET.COM
QA/MSX/CARD/UNAPI.TXT
# ...except the 32MB card image: it is rebuilt (and byte-churns) on every build, so it
# is a local build artifact, not committed. Build it with tools/build_card_img.sh.
QA/CPC/GEOBENCH.IMG
rom/GEOBENCH.ROM
rom/GBALB.ROM
# MSX2 target (issue #287): fetched third-party system files + the rebuilt
# 32MB Nextor image are local artifacts (tools/fetch_msx_deps.sh recreates them)
QA/MSXDEPS/
QA/MSX/GBMSX.IMG
!QA/MSX/Floppies/
!QA/MSX/Floppies/*.DSK
!assets/msx/
!assets/msx/MSXDOS2.BIN

# Raw 1984 emulator screen captures are kept locally only; commit just the
# curated/optimised GIFs under screenshots/.
screenshots/1984-*.gif
